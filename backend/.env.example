# ─────────────────────────────────────────────────────────────────
# AZURE OPENAI CONFIGURATION
# ─────────────────────────────────────────────────────────────────

# The base URL for your Azure OpenAI endpoint.
# Example: https://my-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=your_azure_endpoint_url_here

# Your Azure OpenAI API key.
AZURE_OPENAI_API_KEY=your_azure_api_key_here

# The deployment name for your chat model (e.g., GPT-4 or GPT-3.5-Turbo).
# Default fallback in code is "gpt-5.4-mini" if not set.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# The API version for Azure OpenAI.
# Default fallback in code is "2024-02-15-preview" if not set.
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# (Optional) The deployment name for your embedding model.
# Used for Semantic Drift Check. If not set, the app uses a text-similarity fallback heuristic.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ─────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ─────────────────────────────────────────────────────────────────

# Set to "true" to enable Demo Mode failsafe (bypasses LLM for live demos
# with specific trigger keywords: Asperger, 2011, crisis, suicide, self-harm,
# Hypochondriasis, illness anxiety, ADD, attention deficit).
# Set to "false" or leave empty to use real Azure OpenAI API calls.
DEMO_MODE=false
